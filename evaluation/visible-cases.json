[
  {
    "id": "basic-return-window",
    "messages": [
      {"role": "user", "content": "How long does a regular customer have to return an unused backpack?"}
    ],
    "expect": {
      "must_include": ["30"],
      "must_not_include": ["14 days"],
      "source_filename": "01-returns-policy-current.md"
    }
  },
  {
    "id": "order-status-basic",
    "messages": [
      {"role": "user", "content": "Where is my order ORD-1007?"}
    ],
    "expect": {
      "tool": "order_lookup",
      "must_include": ["shipped", "UPS"]
    }
  },
  {
    "id": "row-plus-shipping-cost",
    "messages": [
      {"role": "user", "content": "Do Row+ members pay for shipping?"}
    ],
